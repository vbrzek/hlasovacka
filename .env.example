# Zkopírujte do .env a upravte.  (.env se necommituje)

# Port, na kterém aplikace poslouchá (3000 bývá na serveru obsazený)
PORT=3210

# 127.0.0.1 = dostupné jen přes reverzní proxy (nginx) na stejném stroji,
# 0.0.0.0  = dostupné přímo zvenku
HOST=127.0.0.1

# Veřejná adresa bez lomítka na konci – použije se v QR kódu a v odkazech
PUBLIC_URL=https://hlasovani.example.cz

# Kam ukládat prezentace a nahrané obrázky (výchozí ./data)
# DATA_DIR=/var/lib/hlasovacka

# Název procesu v PM2 (hodí se, když běží víc kopií na jednom serveru)
# PM2_NAME=hlasovacka
